# ==============================================================================
# MDK Trading Oracle - Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Storage & Database Paths
# Leave commented out to automatically use project-relative ./data folder
# DATA_DIR=./data
# DATABASE_PATH=./data/database/mdk_oracle.duckdb

# Default Market Focus
DEFAULT_MARKET=BIST
PRIMARY_INSTITUTION=MLB
