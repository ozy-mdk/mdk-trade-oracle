# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Market & Institution Focus
DEFAULT_MARKET=BIST
PRIMARY_INSTITUTION=MLB

# External Data Storage (Absolute or user-home path outside code repository, defaults to ~/data/mdk_oracle)
DATA_DIR=~/data/mdk_oracle

# Database Settings (PostgreSQL 16 + TimescaleDB)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=mdk_oracle
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSLMODE=prefer
